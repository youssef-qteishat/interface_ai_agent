# Template. Copy to .env and fill in real values; .env is gitignored.
# Never put a real key in this file — it is committed.

# Required for discovery runs only. Replay and the test suite run without it.
ANTHROPIC_API_KEY=sk-ant-...

# Sandbox surface agent, published to loopback by compose.yaml (Step 3).
SANDBOX_AGENT_URL=http://127.0.0.1:8900

# Discovery loop bounds (Step 11).
DISCOVERY_MAX_STEPS=40
DISCOVERY_WALL_CLOCK_S=300
